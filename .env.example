# Copie para .env  ->  copy .env.example .env
# O .env e lido pelo docker compose neste diretorio. Nao versione o .env.

# ---- Banco de dados (container local) ----
POSTGRES_USER=louvor
POSTGRES_PASSWORD=louvor
POSTGRES_DB=louvor
# Porta exposta no Windows. Mude se voce ja tiver um Postgres local na 5432.
POSTGRES_PORT=5432

# ---- API ----
API_PORT=3000

# Segredo de assinatura dos JWT (minimo 32 caracteres).
# Em producao (Railway) gere um valor unico e aleatorio -- NUNCA reutilize este.
JWT_SECRET=desenvolvimento-local-troque-em-producao-32+

# Base do link de convite. Sem ela a API devolve url:null e o app compartilha
# apenas o codigo -- e o que acontece hoje, ja que nao ha pagina publica.
# Ex.: INVITE_BASE_URL=https://escalas.suaigreja.com/convite
# INVITE_BASE_URL=

# Pasta das fotos de perfil. No compose ela ja vem definida como /app/storage
# (aparece em backend/storage no Windows). Em producao e o ponto de montagem
# do Volume do Railway -- ver railway.toml.
# STORAGE_DIR=/app/storage

# ---- Enriquecimento de musicas (opcional) ----
# So o script prisma/enrich-songs.ts usa; a API nao precisa de nenhuma delas.
# Sem a chave, o provedor correspondente e pulado.
#
# developer.spotify.com/dashboard -> Create app (so a busca e usada).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
#
# console.cloud.google.com -> ative a YouTube Data API v3 e gere uma chave.
# A cota padrao rende ~100 musicas por dia.
# YOUTUBE_API_KEY=
#
# Nao ha chave de letra: 285 das 286 musicas ja tem a letra completa no banco,
# vinda do backup do Holyrics. (A API do Vagalume responde 503 desde 08/2026.)
