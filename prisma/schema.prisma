// Schema do MVP -- ver docs/ARQUITETURA-MVP.md secao 3.
// Convencao: modelos em ingles (PascalCase), tabelas/colunas em snake_case.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  LEADER
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  REMOVED
}

/// A categoria nao e so rotulo: e o que sustenta as regras de escalacao.
/// - INSTRUMENT: no maximo um por pessoa na mesma escala
/// - TECH (multimidia, som): nao acumula com banda (vocal ou instrumento)
enum PositionCategory {
  VOCAL
  INSTRUMENT
  TECH
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  // Sempre gravado em minusculas pela camada de servico (regra 23).
  email              String   @unique
  passwordHash       String   @map("password_hash")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  /// Caminho do arquivo dentro de STORAGE_DIR (ex.: "avatars/<uuid>.jpg"), nao
  /// uma URL: o dominio publico muda entre local e producao, e o app monta o
  /// endereco a partir do proprio host da API.
  avatarPath         String?  @map("avatar_path")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships   Membership[]
  refreshTokens RefreshToken[]
  createdTeams  Team[]         @relation("TeamCreatedBy")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  timezone    String   @default("America/Sao_Paulo")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy        User?             @relation("TeamCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  memberships      Membership[]
  positions        Position[]
  invites          Invite[]
  events           Event[]
  songs            Song[]
  serviceTemplates ServiceTemplate[]

  @@map("teams")
}

/// Vinculo usuario <-> equipe. userId e NULO enquanto o membro for um
/// placeholder criado pelo lider (ver secao 2a do documento de arquitetura).
model Membership {
  id          String           @id @default(uuid()) @db.Uuid
  teamId      String           @map("team_id") @db.Uuid
  userId      String?          @map("user_id") @db.Uuid
  displayName String           @map("display_name")
  role        MembershipRole   @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  phone       String?
  /// Musico de fora convidado para uma ocasiao. Nao tem conta, nao recebe
  /// convite e nao aparece como integrante da equipe -- so pode ser escalado
  /// e sair na escala compartilhada.
  isGuest     Boolean          @default(false) @map("is_guest")
  joinedAt    DateTime?        @map("joined_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // SetNull, nao Cascade: apagar a conta devolve o membro a condicao de
  // placeholder e preserva o historico de escalas.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  positions        MembershipPosition[]
  assignments      Assignment[]
  unavailabilities Unavailability[]
  invitesCreated   Invite[]             @relation("InviteCreatedBy")
  invitesTargeting Invite[]             @relation("InviteTarget")
  eventsCreated    Event[]              @relation("EventCreatedBy")
  eventsMinistered Event[]              @relation("EventMinister")

  // No Postgres, um indice unico permite multiplos NULLs -- exatamente o que
  // queremos: varios placeholders por equipe, mas uma conta so entra uma vez.
  @@unique([teamId, userId])
  @@index([teamId, status])
  @@map("memberships")
}

/// Dias em que o membro avisou que NAO pode ser escalado.
///
/// O modelo e "avisar antes", nao "aceitar depois": a pessoa marca os dias em
/// que estara fora e quem monta a escala ve isso na hora de escalar, em vez de
/// montar a escala e esperar confirmacao de todo mundo.
///
/// Guardado como dia civil (`@db.Date`), nao timestamp: indisponibilidade e um
/// dia inteiro no calendario da equipe, e comparar com o fuso evita o classico
/// "marquei domingo e sumiu no sabado".
model Unavailability {
  id           String   @id @default(uuid()) @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  date         DateTime @db.Date
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, date])
  @@index([membershipId, date])
  @@map("unavailabilities")
}

/// Catalogo de funcoes/instrumentos POR equipe (semeado na criacao da equipe).
model Position {
  id        String           @id @default(uuid()) @db.Uuid
  teamId    String           @map("team_id") @db.Uuid
  name      String
  category  PositionCategory
  sortOrder Int              @default(0) @map("sort_order")
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  team        Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  memberships MembershipPosition[]
  assignments Assignment[]

  @@unique([teamId, name])
  @@index([teamId, isActive])
  @@map("positions")
}

/// Funcoes que o membro sabe exercer.
model MembershipPosition {
  membershipId String @map("membership_id") @db.Uuid
  positionId   String @map("position_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  position   Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@id([membershipId, positionId])
  @@map("membership_positions")
}

model Invite {
  id           String    @id @default(uuid()) @db.Uuid
  teamId       String    @map("team_id") @db.Uuid
  /// Preenchido quando o convite e individual: aceitar reivindica este membro.
  membershipId String?   @map("membership_id") @db.Uuid
  code         String    @unique
  createdById  String?   @map("created_by") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  maxUses      Int?      @map("max_uses")
  uses         Int       @default(0)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership Membership? @relation("InviteTarget", fields: [membershipId], references: [id], onDelete: Cascade)
  createdBy  Membership? @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@map("invites")
}

/// A escala de um dia. Entidade central do sistema.
///
/// Uma escala pode ter mais de um culto (ver [EventService]): no domingo tipico
/// da equipe ha culto de manha e de noite, com a **mesma** escalacao, o mesmo
/// ensaio e o mesmo local. Por isso a escalacao pendura aqui, e nao no culto.
model Event {
  id           String      @id @default(uuid()) @db.Uuid
  teamId       String      @map("team_id") @db.Uuid

  /// Nome do culto especial: "Pascoa", "Ceia", "Batismo".
  ///
  /// Nulo na maioria das escalas, e e o caso normal: o domingo comum ja e
  /// identificado pela data e pelos horarios. Obrigar um titulo produzia
  /// "Domingo" ao lado de um selo que ja dizia DOM 9 AGO -- uma linha inteira
  /// repetindo o que estava do lado.
  title        String?
  /// Instante da escala = horario do culto mais cedo, mantido pelo servico a
  /// cada gravacao. Denormalizado de proposito: e por ele que a agenda ordena,
  /// separa proximos de passados e monta o selo de data. Derivar isso de
  /// `services` em cada consulta trocaria um `order by` indexado por um join
  /// com agregacao, sem nada em troca.
  startsAt     DateTime    @map("starts_at") @db.Timestamptz(3)
  rehearsalAt  DateTime?   @map("rehearsal_at") @db.Timestamptz(3)
  location     String?
  notes        String?
  /// Texto livre: "Preto e dourado".
  colorPalette String?     @map("color_palette")
  status       EventStatus @default(PUBLISHED)
  createdById  String?     @map("created_by") @db.Uuid

  /// Quem ministra o louvor nesta escala.
  ///
  /// Um por escala, nao por funcao: e a pessoa que conduz a ministracao
  /// inteira -- le os versiculos, fala antes das musicas, delega. Ela tambem
  /// esta escalada em alguma funcao, mas o papel nao pertence a funcao.
  ///
  /// Gravado junto da escalacao (`PUT /events/:id/assignments`), que e onde se
  /// sabe quem esta escalado: assim ele nunca aponta para quem saiu da escala.
  ministerMembershipId String? @map("minister_membership_id") @db.Uuid

  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  team        Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   Membership?    @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  minister    Membership?    @relation("EventMinister", fields: [ministerMembershipId], references: [id], onDelete: SetNull)
  assignments Assignment[]
  songs       EventSong[]
  services    EventService[]

  @@index([teamId, startsAt])
  @@map("events")
}

/// Um horario de culto dentro da escala do dia.
///
/// O que muda entre a manha e a noite e o horario -- e, quando a Etapa 6
/// chegar, o repertorio. Equipe, ensaio, local e observacoes sao os mesmos,
/// entao o culto e filho da escala e nao uma escala propria. Modelar como duas
/// escalas obrigaria a escalar a mesma equipe duas vezes e faria o aviso de
/// "mesma pessoa em duas escalas no mesmo dia" disparar todo domingo.
model EventService {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid

  /// Copia do rotulo e do horario no momento em que a escala foi montada.
  ///
  /// E fotografia, nao referencia: se a igreja mudar a noite de 19:00 para
  /// 18:30 no ano que vem, as escalas ja passadas nao podem se reescrever.
  label     String
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  sortOrder Int      @default(0) @map("sort_order")

  /// De qual linha da grade este culto saiu. Nulo em culto avulso (Pascoa,
  /// especial) ou quando a linha da grade foi apagada.
  ///
  /// Existe para uma pergunta so: ao mexer na grade, quais escalas futuras
  /// seriam afetadas? Casar por rotulo e horario seria adivinhacao.
  templateId String? @map("template_id") @db.Uuid

  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template ServiceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  songs    EventSong[]

  @@index([eventId, startsAt])
  @@index([templateId])
  @@map("event_services")
}

/// A grade de cultos da igreja: o que se repete toda semana.
///
/// "Domingo 08:30 Manha", "Domingo 19:00 Noite", "Quinta 19:30". Serve para o
/// lider montar a escala escolhendo uma data em vez de digitar rotulo e
/// horario toda semana -- que era o caminho para ter "Manha", "manha" e
/// "Manhã" em domingos diferentes.
model ServiceTemplate {
  id     String @id @default(uuid()) @db.Uuid
  teamId String @map("team_id") @db.Uuid

  label String

  /// 0 = domingo ... 6 = sabado, igual ao `Date.getDay()` do JS.
  weekday Int

  /// Minutos desde a meia-noite (08:30 = 510).
  ///
  /// Inteiro, e nao um horario com data: a grade e hora de parede no fuso da
  /// equipe, e o instante em UTC so existe quando a data concreta e escolhida.
  /// Guardar um DateTime aqui convidaria a erro de fuso a cada leitura.
  startMinutes Int @map("start_minutes")

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  team     Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  services EventService[]

  @@index([teamId, weekday, startMinutes])
  @@map("service_templates")
}

/// A escalacao: quem toca o que neste evento.
model Assignment {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  positionId   String   @map("position_id") @db.Uuid
  note         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  position   Position   @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@unique([eventId, membershipId, positionId])
  @@index([eventId])
  @@index([membershipId])
  @@map("assignments")
}

/// Repertorio da equipe. Estrutura minima -- a base de musicas externa entra depois
/// pelos campos externalId / externalSource.
/// Hino (do hinario) x cantico (contemporaneo). Fica nulo enquanto ninguem
/// classificou -- o acervo importado do Holyrics chega quase todo assim.
enum SongKind {
  HYMN
  SONG
}

/// "Calma ou agitada", como a equipe descreve. Nao vem de BPM: o Deezer
/// devolve bpm 0 para boa parte do gospel brasileiro, e o que importa e o
/// andamento que a equipe toca, nao o da gravacao.
enum SongPace {
  CALM
  MODERATE
  UPBEAT
}

model Song {
  id       String    @id @default(uuid()) @db.Uuid
  teamId   String    @map("team_id") @db.Uuid
  title    String
  artist   String?
  composer String?
  kind     SongKind?
  pace     SongPace?

  /// Tom em que A EQUIPE canta. Texto livre ("C", "Bm", "Eb"): validar nota
  /// por nota nao impediria nenhum erro real e travaria quem anota
  /// "C (capo 2)". So a equipe preenche -- nenhum script escreve aqui.
  defaultKey String? @map("default_key")

  /// Tom da GRAVACAO, lido da pagina do CifraClub. E sugestao, nao decisao:
  /// serve para a tela oferecer um ponto de partida em vez de campo vazio.
  /// Separado de `defaultKey` de proposito -- misturar os dois faria o campo
  /// significar "nosso tom" em algumas musicas e "o tom do artista" em
  /// outras, e quem canta nao teria como saber qual.
  originalKey String? @map("original_key")

  /// Andamento da gravacao, lido da mesma pagina. Guardado como numero e nao
  /// convertido em `pace` automaticamente: 140 BPM tocado em meio-tempo e
  /// sentido como calmo, entao o numero sugere e a equipe decide.
  bpm Int?

  /// Letra completa. Guardada no banco de proposito: site de letra sai do ar,
  /// muda de endereco e nao funciona no meio do culto sem internet boa.
  lyrics String?

  lyricsUrl  String? @map("lyrics_url")
  chordsUrl  String? @map("chords_url")
  youtubeUrl String? @map("youtube_url")
  spotifyUrl String? @map("spotify_url")

  /// Titulo + artista + compositor em minusculas e sem acento, montado pelo
  /// servico. E o que a busca compara: sem isto, procurar "coracao" nao acha
  /// "Coração", que e exatamente como as pessoas digitam no celular.
  searchText String @map("search_text")

  /// Origem quando a musica veio de fora (ex.: "holyrics" + o id do backup).
  /// E o que torna o import repetivel: rodar de novo atualiza em vez de
  /// duplicar.
  externalId     String? @map("external_id")
  externalSource String? @map("external_source")

  isArchived Boolean  @default(false) @map("is_archived")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  eventSongs EventSong[]

  @@unique([teamId, externalSource, externalId])
  @@index([teamId, isArchived])
  @@map("songs")
}

model EventSong {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid

  /// Em qual culto da escala esta musica entra.
  ///
  /// Obrigatorio: toda escala tem pelo menos um culto, entao nao existe musica
  /// de escala que nao seja de algum culto. Deixar nulavel criaria um estado
  /// "sem culto definido" para carregar na tela, nas consultas e no texto
  /// compartilhado -- e, pior, um balde sem trava: no Postgres NULL e distinto
  /// de NULL em indice unico, entao a chave abaixo nao impediria a mesma
  /// musica repetida entre as linhas sem culto.
  serviceId String @map("service_id") @db.Uuid

  songId String @map("song_id") @db.Uuid

  /// Ordem no repertorio DAQUELE CULTO, normalizada em 0..n-1 pelo servidor.
  position    Int
  keyOverride String? @map("key_override")
  note        String?

  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service EventService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  song    Song         @relation(fields: [songId], references: [id], onDelete: Restrict)

  /// A mesma musica nos dois cultos sao duas linhas, e isso e o certo: a noite
  /// pode ser outro tom, outra ordem, outro recado. O que a chave impede e a
  /// mesma musica duas vezes no MESMO culto.
  @@unique([eventId, serviceId, songId])
  @@index([eventId, position])
  @@map("event_songs")
}
