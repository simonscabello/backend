{
  "name": "escalas-louvor-api",
  "version": "0.1.0",
  "description": "API do sistema de escalas de louvor",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "concurrently -n tsc,api -c blue,green \"npm:dev:build\" \"npm:dev:run\"",
    "dev:build": "nest build --watch --preserveWatchOutput",
    "dev:run": "nodemon",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio --hostname 0.0.0.0",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "prisma": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
